# ================================================================
# LearnHub — Environment Variables
# Copy this file to .env and fill in the values
# ================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_DOMAIN=learnhub.lk

# --- Master Database (PostgreSQL) ---
POSTGRES_USER=learnhub
POSTGRES_PASSWORD=learnhub_dev_password
POSTGRES_DB=learnhub_master
POSTGRES_PORT=5432
MASTER_DATABASE_URL=postgres://8984ae48fd1c835128f6c3df7232bb15cfe06042a3397675387c80acd671f514:sk_Jgwod4TteG__a4lVnJgRy@db.prisma.io:5432/postgres?sslmode=require

# --- Tenant Database Template ---
# Used when provisioning new tenant databases
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=learnhub
TENANT_DB_PASSWORD=learnhub_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=learnhub_redis_dev

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_jwt_secret_64_chars_minimum
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_64_chars_minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Encryption (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_encryption_key

# --- Cloudflare R2 (File Storage) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=learnhub-files
R2_PUBLIC_URL=https://files.learnhub.lk

# --- Bunny.net CDN (Video Delivery) ---
BUNNY_API_KEY=your_bunny_api_key
BUNNY_LIBRARY_ID=your_bunny_library_id
BUNNY_CDN_HOSTNAME=your_bunny_cdn_hostname

# --- Resend (Transactional Email) ---
RESEND_API_KEY=re_8LFmwmwQ_GH28sTDPPD1q97WoGP5HZMCK
EMAIL_FROM=innovationforexa@gmail.com

# --- SMS (Dialog/Mobitel) ---
SMS_API_URL=https://sms-gateway-url.lk/api/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=LearnHub

# --- PayHere (Payment Gateway - Sri Lanka) ---
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk

# --- Frontend ---
FRONTEND_PORT=4200
BACKEND_PORT=3000
